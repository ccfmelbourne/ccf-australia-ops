# Copy this file to .env and fill in real values. .env is gitignored
# (see .gitignore's `.env*` rule) — never commit real credentials.

# PostgreSQL connection string (ADR 0002: managed Postgres). See
# docs/mvp/test-environment.md's sibling for the equivalent Track B guide
# once written, or provision via Neon/Vercel Postgres/Supabase for local dev.
DATABASE_URL="postgresql://user:password@localhost:5432/ccf_finance?schema=public"

# Slice-1 "Finance login" — a single, minimal, env-configured identity.
# Real multi-user auth is a later slice; see .ai/PROJECT.md Phase Transition
# and src/lib/finance-auth.ts.
FINANCE_ACCOUNTANT_NAME="Finance"
FINANCE_ACCOUNTANT_EMAIL="finance@example.org"
FINANCE_ACCOUNTANT_PASSWORD="change-me"

# Random secret used to HMAC-sign the Finance login session cookie. Generate
# one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FINANCE_SESSION_SECRET=""

# Resend (https://resend.com) — sends the requester notification email when
# Finance changes a request's status. EMAIL_FROM_ADDRESS must be on a domain
# verified in Resend (it cannot send "from" a Gmail/Workspace address CCF
# doesn't control the DNS for). See src/lib/notifications.ts.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="CCF Finance <notifications@example.org>"

# Cloudflare R2 (S3-compatible) — receipt storage (ADR 0002, `oc` Oceania
# location hint). Create a bucket + a "Object Read & Write" API token
# scoped to it: Cloudflare dashboard -> R2 -> Manage API Tokens. See
# src/lib/receipt-storage.ts.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ccf-finance-receipts"

# Google OAuth ("Sign in with Google") for requesters/approvers — separate
# from Finance's own single-shared-credential login. Create an OAuth 2.0
# Client ID (Web application) in Google Cloud Console; GOOGLE_REDIRECT_URI
# must exactly match an authorized redirect URI registered there. See
# src/lib/google-oauth.ts.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Random secret used to HMAC-sign the requester/approver session cookie —
# separate from FINANCE_SESSION_SECRET above (independent session systems).
# Generate the same way: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=""
