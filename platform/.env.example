# Copy this file to .env and fill in real values. .env is gitignored
# (see .gitignore's `.env*` rule) — never commit real credentials.

# PostgreSQL connection string (ADR 0002: managed Postgres). See
# docs/mvp/test-environment.md's sibling for the equivalent Track B guide
# once written, or provision via Neon/Vercel Postgres/Supabase for local dev.
DATABASE_URL="postgresql://user:password@localhost:5432/ccf_finance?schema=public"

# Resend (https://resend.com) — sends the approved-request notification
# (voucher PDF + receipts) once a request clears its full approval chain.
# EMAIL_FROM_ADDRESS must be on a domain verified in Resend (it cannot send
# "from" a Gmail/Workspace address CCF doesn't control the DNS for). See
# src/lib/notifications.ts.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="CCF Finance <notifications@example.org>"

# TEMPORARY test recipient for the approved-request notification -- the real
# Finance inbox hasn't been decided yet. Replace with the real address
# before go-live.
FINANCE_NOTIFICATION_EMAIL="cosccfmelbourne@gmail.com"

# Cloudflare R2 (S3-compatible) — receipt storage (ADR 0002, `oc` Oceania
# location hint). Create a bucket + a "Object Read & Write" API token
# scoped to it: Cloudflare dashboard -> R2 -> Manage API Tokens. See
# src/lib/receipt-storage.ts.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ccf-finance-receipts"

# Google OAuth ("Sign in with Google") for requesters/approvers — separate
# from Finance's own single-shared-credential login. Create an OAuth 2.0
# Client ID (Web application) in Google Cloud Console; GOOGLE_REDIRECT_URI
# must exactly match an authorized redirect URI registered there. See
# src/lib/google-oauth.ts.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Random secret used to HMAC-sign the requester/approver session cookie.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=""

# Authenticates Vercel Cron's daily trigger for
# /api/cron/cleanup-stale-drafts (vercel.json's "crons") -- Vercel
# automatically sends `Authorization: Bearer $CRON_SECRET` when this is
# set. Set the same value here for local testing and in the Vercel
# dashboard's Environment Variables for the real deployed cron.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# The Chief-of-Staff approval pool -- comma-separated real emails, exactly
# who's authorized to claim a COS1/COS2 approval slot (approval-routing.ts's
# COS_POOL). One of these must also be set as
# REGIONAL_DIRECTOR_OVERRIDE_CONFIRMER_EMAIL below. Kept out of source
# control since these are real people's real addresses.
COS_POOL_EMAILS="approver1@example.org,approver2@example.org,approver3@example.org"

# The one specific person authorized to confirm a tier-4 request is "within
# budget" as an alternative path to a direct Regional Director decision (see
# approval-routing.ts). Must be one of COS_POOL_EMAILS above.
REGIONAL_DIRECTOR_OVERRIDE_CONFIRMER_EMAIL="approver1@example.org"

# Google Cloud Vision API (Document Text Detection) — powers the opt-in
# "scan receipt for suggested information" feature (JPEG/PNG/GIF/PDF/TIFF;
# HEIC isn't supported by Vision). Server-side only, never exposed to the
# browser. Setup: create a GCP project, enable the Vision API, create a
# Service Account with no roles beyond default (Vision auth doesn't need
# IAM roles, just a valid credential), generate a JSON key for it, and
# paste the ENTIRE key file's JSON contents here as a single-line string.
# The free monthly allowance covers pilot-scale volume. See
# src/lib/receipt-extraction/.
GOOGLE_VISION_CREDENTIALS_JSON=""
