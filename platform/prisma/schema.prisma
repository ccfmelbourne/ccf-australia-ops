// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Subset of specs/0002-reimbursement-data-model-api.md (repo root).
//
// BankDetails encryption-at-rest: relies on Neon's standard disk-level
// encryption + strict access control (owner-only reads) for now.
// Application-level field encryption is an open TODO -- see spec 0002's
// "Sensitive data" section -- deferred since it needs new key-management
// infrastructure not present anywhere else in this codebase. Decision-maker
// call (2026-08-30): build it before the official testing phase begins,
// not before then.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestType {
  CASH_ADVANCE
  REIMBURSEMENT
  LIQUIDATION_OF_CASH_ADVANCE
  BENEVOLENCE
  PAYMENT_TO_SUPPLIER
  STATE_INTERNATIONAL_TRANSFER
}

// Started as the Track A pilot's 10 values, mirrored 1:1. Split
// COMMS_MEDIA_DGM into COMMS_MEDIA + DGM (2026-08-31): confirmed the two
// have different named approvers, so each ministry type is assigned its
// own approver individually, not grouped as the pilot's approval-rules.js
// did. Also split EVENTS_HOST into EVENTS_RETREAT + HOST (2026-09-01) for
// the same reason, and fixed the OCEANA_REGIONAL -> OCEANIA_REGIONAL
// spelling.
enum MinistryType {
  ADMIN
  EXALT_LIVE_PROD
  FINANCE
  NXTGEN
  PASTORAL_CARE
  B1G
  ELEVATE
  EVENTS_RETREAT
  HOST
  COMMS_MEDIA
  DGM
  OCEANIA_REGIONAL
}

// SUBMITTED/READY_FOR_PROCESSING/PROCESSING/PROCESSED removed 2026-09-02 --
// vestigial from before Finance retired from the app entirely (no in-app
// transition has ever produced any of them; a request goes straight from
// DRAFT to IN_APPROVAL, and terminates at APPROVED or REJECTED_RETURNED).
enum RequestStatus {
  DRAFT
  IN_APPROVAL
  APPROVED
  NEEDS_CLARIFICATION
  REJECTED_RETURNED
}

// COS1/COS2 aren't ministry-specific or person-specific slots -- they're
// two claimable positions, open to any of a shared pool of real people
// (approval-routing.ts's COS_POOL, configured via env, not hardcoded).
// RequiredApproval rows for these roles are created with
// approverUserId null and get claimed (approverUserId set) by whichever
// pool member decides them first -- see approval-data.ts's decideApproval.
// Corrected 2026-09-02 from an earlier, wrong fixed-slot-per-person model
// (which briefly also had a COS3, since removed -- tier 4 only ever needs
// the same 2 COS slots as tier 3, not a third).
enum ApproverRole {
  MINISTRY_OVERSEER
  COS1
  COS2
  FINANCE_OVERSEER
  REGIONAL_DIRECTOR
}

// AUTO_SATISFIED added 2026-09-02: when the requester themselves is the
// designated approver for a role (e.g. a Ministry Overseer submitting
// their own ministry's request), that tier is satisfied automatically at
// submit time instead of requiring them to click "Approve" on their own
// submission -- confirmed business rule: a requester must never perform
// a manual approval action on their own reimbursement, but where policy
// explicitly designates them as the approver for a tier, that tier may be
// auto-satisfied, with an explicit audit record (RequiredApproval.comments)
// explaining why. Every subsequent tier still requires independent
// approval -- see approval-data.ts/request-data.ts's submitRequest.
enum ApprovalStatus {
  PENDING
  APPROVED
  AUTO_SATISFIED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  googleSub String?  @unique // Google's stable "sub" claim; nullable so existing
                              // Finance/seeded rows (created before Google sign-in existed)
                              // stay valid, and so a first Google sign-in can match-or-create
                              // by email then backfill this.
  picture   String?  // Google profile picture URL, display only
  createdAt DateTime @default(now())

  requestsMade        ReimbursementRequest[] @relation("Requester")
  approvals           RequiredApproval[]
  auditEntries        AuditLogEntry[]
  approverAssignments ApproverAssignment[]
}

model ReimbursementRequest {
  id           String        @id @default(cuid())
  voucherNo    String        @unique
  requestType  RequestType
  ministryType MinistryType
  requesterId  String
  requester    User          @relation("Requester", fields: [requesterId], references: [id])
  totalAmount  Decimal       @db.Decimal(12, 2)
  status       RequestStatus @default(DRAFT)
  submittedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lineItems         LineItem[]
  receipts          Receipt[]
  bankDetails       BankDetails?
  requiredApprovals RequiredApproval[]
  auditLog          AuditLogEntry[]

  // R2 object key for the requester's own drawn signature (PNG), captured
  // as the last step of every submission -- set fresh on each submitRequest
  // call (request-data.ts), first submission and every resubmission alike,
  // since each is its own attestation. The previous R2 object is deleted
  // when a resubmission replaces it.
  requesterSignatureStorageKey String?

  // Set only when the designated confirmer (approval-routing.ts's
  // REGIONAL_DIRECTOR_OVERRIDE_CONFIRMER_EMAIL) explicitly confirms a
  // tier-4 request is within budget, as an alternative to waiting on
  // direct Regional Director approval -- see approval-data.ts's
  // confirmRegionalDirectorOverride/isFullyApproved. Requires COS1+COS2
  // to both be APPROVED first.
  regionalDirectorOverrideConfirmedAt DateTime?

  // Set once each stale-draft reminder tier has been emailed to the
  // requester (cron/remind-stale-drafts) -- see sendStaleDraftReminders.
  staleReminder3DaySentAt DateTime?
  staleReminder7DaySentAt DateTime?
}

model LineItem {
  id                     String               @id @default(cuid())
  reimbursementRequestId String
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  description            String
  amount                 Decimal              @db.Decimal(12, 2)
}

model Receipt {
  id                     String               @id @default(cuid())
  reimbursementRequestId String
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  storageKey             String
  uploadedAt             DateTime             @default(now())
  // Set together, only when OCR extraction found both a merchant name and
  // a valid positive amount right after upload -- that pair is what
  // auto-creates a real LineItem (uploadReceiptAction,
  // requests/actions.ts). scannedAt null covers both "hasn't been
  // scanned yet" and "scanned but couldn't extract enough to act on" --
  // both render the same "add manually" state on the receipt's card, no
  // separate boolean needed.
  extractedMerchant      String?
  // The product bought, when the scan could isolate exactly one product
  // line -- null for multi-item receipts (see parseItemDescription).
  // Combined with extractedMerchant as "<merchant> | <item>" wherever the
  // two are shown together (the receipt card, the auto-created LineItem
  // description, and therefore the voucher PDF).
  extractedItem          String?
  extractedAmount        Decimal?             @db.Decimal(12, 2)
  scannedAt              DateTime?
}

// One-to-one, kept as its own table (not columns on ReimbursementRequest)
// so it can be access-restricted / encrypted independently -- see spec
// 0002's "Sensitive data" section. Owner-only (requester on their own
// DRAFT request); no other route reads this.
model BankDetails {
  id                     String               @id @default(cuid())
  reimbursementRequestId String               @unique
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  accountName            String
  bsb                    String
  accountNumber          String
  updatedAt              DateTime             @updatedAt
}

model RequiredApproval {
  id                     String               @id @default(cuid())
  reimbursementRequestId String
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  role                   ApproverRole
  approverUserId         String?
  approver               User?                @relation(fields: [approverUserId], references: [id])
  status                 ApprovalStatus       @default(PENDING)
  decidedAt              DateTime?
  comments               String?
  // R2 object key for the approver's drawn signature (PNG), captured at the
  // moment of approval. Null for PENDING rows and for rows decided before
  // this feature existed -- the voucher PDF renders a "No signature on
  // file" fallback for those rather than assuming one always exists.
  signatureStorageKey    String?

  // Set explicitly (not @updatedAt) whenever this row becomes PENDING --
  // drives the approver reminder schedule, see approval-data.ts's
  // sendPendingApprovalReminders.
  pendingSinceAt      DateTime?
  // Cleared back to null alongside pendingSinceAt on every reset, so an
  // earlier pending period's reminder doesn't suppress a fresh one.
  reminder2DaySentAt DateTime?
  reminder5DaySentAt DateTime?
  reminder7DaySentAt DateTime?

  @@unique([reimbursementRequestId, role])
}

// Static reference data: which User fills a given approver role. Only
// MINISTRY_OVERSEER (ministry-specific) and FINANCE_OVERSEER/
// REGIONAL_DIRECTOR (org-wide, ministryType null) are pre-resolved here.
// COS1/COS2 are deliberately absent -- they're claimable positions open to
// any of approval-routing.ts's COS_POOL, not a single pre-assigned person
// (see request-data.ts's resolveApprover). Resolved once, at Submit time --
// reassigning someone here does not retroactively change who's on an
// already-submitted request's approval chain.
//
// Postgres unique constraints treat NULL as distinct from itself, so
// @@unique([role, ministryType]) only actually enforces one-row-per-ministry
// for the ministry-scoped rows -- the two org-wide rows rely on the seed
// script being correct, not a DB constraint. Acceptable for this small,
// internally-seeded table.
model ApproverAssignment {
  id           String        @id @default(cuid())
  role         ApproverRole
  ministryType MinistryType?
  userId       String
  user         User          @relation(fields: [userId], references: [id])

  @@unique([role, ministryType])
}

model AuditLogEntry {
  id                     String               @id @default(cuid())
  reimbursementRequestId String
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  actorUserId            String
  actor                  User                 @relation(fields: [actorUserId], references: [id])
  action                 String
  details                Json?
  createdAt              DateTime             @default(now())
}
