// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Subset of specs/0002-reimbursement-data-model-api.md (repo root).
//
// BankDetails encryption-at-rest: relies on Neon's standard disk-level
// encryption + strict access control (owner-only reads) for now.
// Application-level field encryption is an open TODO -- see spec 0002's
// "Sensitive data" section -- deferred since it needs new key-management
// infrastructure not present anywhere else in this codebase. Decision-maker
// call (2026-08-30): build it before the official testing phase begins,
// not before then.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestType {
  CASH_ADVANCE
  REIMBURSEMENT
  LIQUIDATION_OF_CASH_ADVANCE
  BENEVOLENCE
  PAYMENT_TO_SUPPLIER
  STATE_INTERNATIONAL_TRANSFER
}

// Started as the Track A pilot's 10 values, mirrored 1:1. Split
// COMMS_MEDIA_DGM into COMMS_MEDIA + DGM (2026-08-31): they have different
// named approvers (Dexter Santiago vs. Moriz Manlangit) -- confirmed each
// ministry type is assigned its own approver individually, not grouped as
// the pilot's approval-rules.js did.
// 2026-09-01: split EVENTS_HOST into EVENTS_RETREAT + HOST -- confirmed
// these are two distinct ministries with different named overseers (Eland
// Afuang vs. Lawrence Hernando), same reasoning as the split above. Also
// fixed the OCEANA_REGIONAL -> OCEANIA_REGIONAL spelling.
enum MinistryType {
  ADMIN
  EXALT_LIVE_PROD
  FINANCE
  NXTGEN
  PASTORAL_CARE
  B1G
  ELEVATE
  EVENTS_RETREAT
  HOST
  COMMS_MEDIA
  DGM
  OCEANIA_REGIONAL
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  IN_APPROVAL
  APPROVED
  READY_FOR_PROCESSING
  NEEDS_CLARIFICATION
  PROCESSING
  PROCESSED
  REJECTED_RETURNED
}

enum ApproverRole {
  MINISTRY_OVERSEER
  COS1
  COS2
  FINANCE_OVERSEER
  REGIONAL_DIRECTOR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  googleSub String?  @unique // Google's stable "sub" claim; nullable so existing
                              // Finance/seeded rows (created before Google sign-in existed)
                              // stay valid, and so a first Google sign-in can match-or-create
                              // by email then backfill this.
  picture   String?  // Google profile picture URL, display only
  createdAt DateTime @default(now())

  requestsMade        ReimbursementRequest[] @relation("Requester")
  approvals           RequiredApproval[]
  overrideApprovals   OverrideApproval[]
  auditEntries        AuditLogEntry[]
  approverAssignments ApproverAssignment[]
}

model ReimbursementRequest {
  id           String        @id @default(cuid())
  voucherNo    String        @unique
  requestType  RequestType
  ministryType MinistryType
  requesterId  String
  requester    User          @relation("Requester", fields: [requesterId], references: [id])
  totalAmount  Decimal       @db.Decimal(12, 2)
  status       RequestStatus @default(DRAFT)
  submittedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lineItems         LineItem[]
  receipts          Receipt[]
  bankDetails       BankDetails?
  requiredApprovals RequiredApproval[]
  regionalOverride  RegionalDirectorOverride?
  auditLog          AuditLogEntry[]
}

model LineItem {
  id                     String               @id @default(cuid())
  reimbursementRequestId String
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  description            String
  amount                 Decimal              @db.Decimal(12, 2)
}

model Receipt {
  id                     String               @id @default(cuid())
  reimbursementRequestId String
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  storageKey             String
  uploadedAt             DateTime             @default(now())
}

// One-to-one, kept as its own table (not columns on ReimbursementRequest)
// so it can be access-restricted / encrypted independently -- see spec
// 0002's "Sensitive data" section. Owner-only (requester on their own
// DRAFT request); no other route reads this.
model BankDetails {
  id                     String               @id @default(cuid())
  reimbursementRequestId String               @unique
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  accountName            String
  bsb                    String
  accountNumber          String
  updatedAt              DateTime             @updatedAt
}

model RequiredApproval {
  id                     String               @id @default(cuid())
  reimbursementRequestId String
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  role                   ApproverRole
  approverUserId         String?
  approver               User?                @relation(fields: [approverUserId], references: [id])
  status                 ApprovalStatus       @default(PENDING)
  decidedAt              DateTime?
  comments               String?
  // R2 object key for the approver's drawn signature (PNG), captured at the
  // moment of approval. Null for PENDING rows and for rows decided before
  // this feature existed -- the voucher PDF renders a "No signature on
  // file" fallback for those rather than assuming one always exists.
  signatureStorageKey    String?

  @@unique([reimbursementRequestId, role])
}

// Tier-4 (>$5,000) alternative to the REGIONAL_DIRECTOR RequiredApproval
// row -- confirmed with leadership (specs/0001, "Regional Director approval
// & COS override"): only created if the requester or one of the three
// named committee members (hardcoded in approval-routing.ts, not resolved
// via ApproverAssignment -- this is a fixed committee, not "any 3 COS")
// chooses to pursue it instead of waiting on the Regional Director.
// withinBudget flips true only once all 3 OverrideApproval rows are
// approved -- their unanimous approval *is* the within-budget attestation,
// no separate budget-plan lookup (per spec 0001).
model RegionalDirectorOverride {
  id                     String               @id @default(cuid())
  reimbursementRequestId String               @unique
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  withinBudget           Boolean              @default(false)
  createdAt              DateTime             @default(now())

  approvals              OverrideApproval[]
}

// Exactly three rows per override, one each for the fixed committee.
model OverrideApproval {
  id             String                   @id @default(cuid())
  overrideId     String
  override       RegionalDirectorOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)
  approverUserId String
  approver       User                     @relation(fields: [approverUserId], references: [id])
  approved       Boolean                  @default(false)
  decidedAt      DateTime?

  @@unique([overrideId, approverUserId])
}

// Static reference data: which User fills a given approver role, either
// for a specific ministry (MINISTRY_OVERSEER/COS1) or org-wide
// (FINANCE_OVERSEER/REGIONAL_DIRECTOR, ministryType null). No COS2 rows
// exist for any ministry -- confirmed there is currently no one in that
// slot anywhere, not a gap in this table. Resolved once, at Submit time --
// reassigning someone here does not retroactively change who's on an
// already-submitted request's approval chain.
//
// Postgres unique constraints treat NULL as distinct from itself, so
// @@unique([role, ministryType]) only actually enforces one-row-per-ministry
// for the ministry-scoped rows -- the two org-wide rows rely on the seed
// script being correct, not a DB constraint. Acceptable for this small,
// internally-seeded table.
model ApproverAssignment {
  id           String        @id @default(cuid())
  role         ApproverRole
  ministryType MinistryType?
  userId       String
  user         User          @relation(fields: [userId], references: [id])

  @@unique([role, ministryType])
}

model AuditLogEntry {
  id                     String               @id @default(cuid())
  reimbursementRequestId String
  request                ReimbursementRequest @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)
  actorUserId            String
  actor                  User                 @relation(fields: [actorUserId], references: [id])
  action                 String
  details                Json?
  createdAt              DateTime             @default(now())
}
